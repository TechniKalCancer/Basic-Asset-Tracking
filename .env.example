# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

SECRET_KEY=dev-secret-change-in-prod
ADMIN_PASSWORD=admin123
DATABASE_URL=sqlite:///assets.db

# ─── Database (Postgres via docker-compose) ────────────────────────────────────
# Only used when running via `docker compose up` — the web container's
# DATABASE_URL is built from these and points at the `db` service automatically,
# overriding the sqlite default above. Running app.py directly (outside Docker)
# still uses the sqlite fallback unless you set DATABASE_URL yourself.
# Change POSTGRES_PASSWORD before first startup — it sets the password for a
# brand-new database; changing it later won't update an already-initialized one.
POSTGRES_USER=asset_tracker
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=asset_tracker

# ─── Production hardening ──────────────────────────────────────────────────────
# FLASK_ENV=production (the default if unset) enables startup warnings when
# SECRET_KEY/ADMIN_PASSWORD are left at their dev fallback values. Set to
# "development" locally to silence those warnings during local testing.
FLASK_ENV=development
# FLASK_DEBUG must stay false/unset in production — it enables the interactive
# debugger and auto-reloader, both unsafe on a public-facing deployment.
FLASK_DEBUG=false
# FORCE_HTTPS=true marks the session cookie Secure (HTTPS-only). Enable this
# once you're actually serving over HTTPS (e.g. behind a reverse proxy with TLS).
FORCE_HTTPS=false

# ─── Google Workspace sync (Stage 2 — optional, not yet implemented) ──────────
# Leave both blank to leave Google sync disabled; the app runs fine without them.
# GOOGLE_SERVICE_ACCOUNT_FILE: path to a service-account JSON key with
#   domain-wide delegation authorized for the
#   admin.directory.device.chromeos.readonly scope in your Workspace Admin console.
# GOOGLE_ADMIN_IMPERSONATE_EMAIL: a super admin account for the service account
#   to impersonate (Admin SDK calls must act as a real admin user).
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_ADMIN_IMPERSONATE_EMAIL=

# ─── Email / overdue reminders (Google SMTP) ──────────────────────────────────
# Leave SMTP_USERNAME/SMTP_PASSWORD blank to leave email disabled; the app runs
# fine without them, the Send Reminders button just stays disabled.
# Uses Gmail's SMTP server by default. You need a Gmail App Password, not your
# regular account password (regular passwords don't work here with 2FA enabled):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-character password below, not your normal Gmail password.
# Works the same way for a Google Workspace account, as long as your admin
# hasn't disabled App Passwords for the domain.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
